body {
    background: #c0c0c0;
    font-family: "Times New Roman", serif;
    color: black;
    margin: 0;
}

header {
    background: navy;
    color: white;
    text-align: center;
    padding: 20px;
    border-bottom: 4px solid black;
}

nav {
    margin-top: 10px;
}

nav a {
    color: cyan;
    font-weight: bold;
    margin: 0 10px;
    text-decoration: underline;
}

nav a:visited {
    color: magenta;
}

main {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
}

.gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.gallery img {
    width: 250px;
    height: 250px;
    object-fit: cover;

    border: 6px ridge white;
    background: white;
    padding: 4px;

    transition: transform 0.2s;
}

.gallery img:hover {
    transform: scale(1.05);
}

footer {
    text-align: center;
    padding: 20px;
}
